# ==============================================================================
# AEGIS-KERNEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Nebius Token Factory (Mandatory for Cloud Model & Sandbox Execution)
# Claim $25 credits using promo code: NEBIUS-DEVPOST-GLOBAL26 at https://nebius.com/promo-code
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra
NEMOTRON_NANO_MODEL=nvidia/nemotron-nano

# 2. Tavily Search API (Mandatory for the $3,000 "Best Use of Tavily" Prize)
# Get a free API key (1,000 free searches/month) at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Sandbox Execution Mode: "auto", "nebius", or "local"
# "auto": Uses Nebius Token Factory Sandboxes when NEBIUS_API_KEY is present, with local fallback
SANDBOX_MODE=auto

# 4. Database Storage (Default: zero-dependency SQLite)
DATABASE_URL=sqlite+aiosqlite:///./aegis_kernel.db
